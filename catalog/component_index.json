{
  "schema_version": 1,
  "scope": "Main-branch component entrypoints; not exhaustive per-file coverage or proof of device acceptance",
  "development_host": "macOS",
  "prototype_target": "Raspberry Pi Linux aarch64 (hardware selection and field acceptance pending)",
  "components": [
    {
      "id": "workspace",
      "boundary": "Shared Cargo package and compiler contracts; no platform-specific code moves.",
      "hardware_gate": "software_only",
      "code": [
        "Cargo.toml",
        "rust-toolchain.toml",
        "crates/pipboy-core/Cargo.toml",
        "crates/pipboy/Cargo.toml",
        "crates/rust-boy-broker/Cargo.toml",
        "crates/pipboy-core/src/lib.rs",
        "crates/pipboy/src/main.rs"
      ],
      "docs": [
        "docs/ARCHITECTURE.md",
        "docs/REPO_STRUCTURE.md"
      ],
      "checks": [
        "tools/validate_rust_version.py"
      ]
    },
    {
      "id": "runtime-policy",
      "boundary": "Canonical runtime, module registry and capabilities; browser UI cannot grant permissions.",
      "hardware_gate": "software_only",
      "code": [
        "crates/pipboy-core/src/runtime.rs",
        "crates/pipboy-core/src/registry.rs",
        "crates/pipboy-core/src/capability.rs",
        "crates/pipboy-core/src/permissions.rs"
      ],
      "docs": [
        "docs/OBJECT_MODEL.md",
        "docs/PERMISSIONS.md"
      ],
      "checks": [
        "tools/smoke_runtime.py",
        "tools/smoke_permissions.py"
      ]
    },
    {
      "id": "package-socket-contract",
      "boundary": "Bounded manifest registry, typed message codecs, Unix stream sessions with absolute I/O deadlines, version negotiation and request correlation; no package execution, peer authentication or capability grants.",
      "hardware_gate": "software_only",
      "code": [
        "crates/pipboy-core/src/package_socket.rs",
        "crates/pipboy-core/src/package_listener.rs",
        "crates/pipboy-core/src/package_transport.rs"
      ],
      "docs": [
        "docs/PACKAGE_SOCKET.md",
        "docs/HOST_PACKAGE_ROADMAP.md",
        "docs/VALIDATION.md"
      ],
      "checks": [
        "tools/validate_host_packages.py",
        "tools/test_validate_host_packages.py"
      ],
      "acceptance": "Typed protocol negotiation, sequencing, correlation, frame bounds and deadline-bounded Unix exchanges are unit-tested. Private-directory socket creation, mode 0600, OS-reported peer UID/PID matching, occupied-path refusal and guarded cleanup are tested; host process launch, binary signature verification, capability brokerage and process isolation remain open."
    },
    {
      "id": "workbenches",
      "boundary": "Roles and operator workbench state live in Rust; Custom has no duplicate JS roster.",
      "hardware_gate": "software_only",
      "code": [
        "crates/pipboy-core/src/workbench.rs",
        "crates/pipboy/src/workbench.rs"
      ],
      "docs": [
        "docs/ROLE_ROADMAP.md"
      ],
      "checks": [
        "tools/validate_roles.py",
        "tools/smoke_workbench.py"
      ]
    },
    {
      "id": "local-hud",
      "boundary": "One loopback HTTP authority and shared desktop/micro shells.",
      "hardware_gate": "software_only",
      "code": [
        "crates/pipboy/src/dashboard.rs",
        "crates/pipboy/assets/dashboard.html",
        "crates/pipboy/assets/dashboard.css",
        "crates/pipboy/assets/dashboard.js",
        "crates/pipboy/assets/micro.js"
      ],
      "docs": [
        "docs/DASHBOARD_UI.md",
        "docs/MICRO_UI.md",
        "docs/HOST_PACKAGE_ROADMAP.md"
      ],
      "checks": [
        "tools/smoke_dashboard.py",
        "tools/smoke_micro.py",
        "tools/test_dashboard_viewport.cjs",
        "tools/test_desktop_viewport.cjs",
        "tools/test_desktop_focus_ui.cjs",
        "tools/test_micro_ui.cjs"
      ]
    },
    {
      "id": "scout-mapping",
      "boundary": "Geospatial data and county cache with explicit location permission; GNSS hardware later.",
      "hardware_gate": "field_pending",
      "code": [
        "crates/pipboy-core/src/scout_gis.rs",
        "crates/pipboy/src/county_cache.rs",
        "crates/pipboy/assets/map.js"
      ],
      "docs": [
        "docs/SCOUT_GPS_MAP.md",
        "docs/COUNTY_SOURCES.md"
      ],
      "checks": [
        "tools/smoke_scout.py",
        "tools/test_map_boot.cjs"
      ]
    },
    {
      "id": "network-engineering",
      "boundary": "Bounded, authorized LAN probes and optional read-only UniFi access.",
      "hardware_gate": "field_pending",
      "code": [
        "crates/pipboy-core/src/network_suite.rs",
        "crates/pipboy-core/src/network_probe.rs",
        "crates/pipboy/src/endpoint_probe.rs",
        "crates/pipboy/src/dashboard/network_routes.rs",
        "crates/pipboy/assets/network.js"
      ],
      "docs": [
        "docs/NETWORK_ENGINEERING.md",
        "docs/NETWORK_HEALTH_UNIFI.md"
      ],
      "checks": [
        "tools/smoke_network.py",
        "tools/smoke_network_health.py"
      ]
    },
    {
      "id": "pace-messaging",
      "boundary": "Message envelope and durable queue in core, explicit peer transport in binary.",
      "hardware_gate": "field_pending",
      "code": [
        "crates/pipboy-core/src/message_protocol.rs",
        "crates/pipboy-core/src/message_pace.rs",
        "crates/pipboy-core/src/messenger.rs",
        "crates/pipboy/src/dashboard/messenger_routes.rs",
        "crates/pipboy/src/peer.rs",
        "crates/pipboy/assets/messenger.js"
      ],
      "docs": [
        "docs/MESSENGER.md",
        "docs/PACE_MESSAGING.md"
      ],
      "checks": [
        "tools/smoke_messenger_protocol.py",
        "tools/smoke_peer.py"
      ]
    },
    {
      "id": "task-control",
      "boundary": "Revisioned task persistence and acknowledgements live in Rust; HUD presents the shared state.",
      "hardware_gate": "software_only",
      "code": [
        "crates/pipboy-core/src/tasks.rs",
        "crates/pipboy/src/dashboard/task_routes.rs",
        "crates/pipboy/assets/tasks.js"
      ],
      "docs": [
        "docs/TASK_CONTROL.md"
      ],
      "checks": [
        "tools/smoke_tasks.py"
      ]
    },
    {
      "id": "operator-storage",
      "boundary": "Private state persists under PIPBOY_HOME and is never checked into the repository.",
      "hardware_gate": "software_only",
      "code": [
        "crates/pipboy-core/src/notes.rs"
      ],
      "docs": [
        "docs/STORAGE.md"
      ],
      "checks": [
        "tools/smoke_notes.py"
      ]
    },
    {
      "id": "game-mode",
      "boundary": "Game session logic stays separated from offline handheld controls; console interop needs testing.",
      "hardware_gate": "field_pending",
      "code": [
        "crates/pipboy-core/src/game.rs",
        "crates/pipboy/src/game.rs"
      ],
      "docs": [
        "docs/GAME_MODE.md"
      ],
      "checks": [
        "tools/smoke_game.py"
      ]
    },
    {
      "id": "reclamation",
      "boundary": "Local site records and manual observations; never fabricate sensor readings.",
      "hardware_gate": "software_only",
      "code": [
        "crates/pipboy-core/src/reclamation.rs",
        "crates/pipboy/assets/reclamation.js"
      ],
      "docs": [
        "docs/RECLAMATION.md"
      ],
      "checks": [
        "tools/test_reclamation_map.cjs"
      ]
    },
    {
      "id": "device-broker",
      "boundary": "Deny-only peripheral broker with synthetic adapters; no physical hardware grants.",
      "hardware_gate": "deny_only",
      "code": [
        "crates/rust-boy-broker/src/main.rs",
        "crates/pipboy-core/src/mock_adapters.rs"
      ],
      "docs": [
        "docs/BROKER_PROTOCOL.md",
        "docs/OS_DEVICE_BROKER.md"
      ],
      "checks": [
        "tools/smoke_broker.py",
        "tools/smoke_mock_adapters.py"
      ]
    },
    {
      "id": "research-and-catalog",
      "boundary": "Cited source evidence and stable role/module IDs, not licensed code ingestion.",
      "hardware_gate": "software_only",
      "code": [
        "catalog/literature.json",
        "catalog/module_plan.json",
        "catalog/role_roadmap.json",
        "catalog/sources.json"
      ],
      "docs": [
        "docs/LITERATURE_MATRIX.md",
        "docs/MODULE_CATALOG.md"
      ],
      "checks": [
        "tools/validate_catalog.py",
        "tools/validate_roles.py"
      ]
    },
    {
      "id": "quality-gates",
      "boundary": "One CI pipeline, documented acceptance and an explicit smoke roster.",
      "hardware_gate": "software_only",
      "code": [
        ".github/workflows/rust.yml",
        "scripts/ci_bootstrap.sh",
        "tools/run_smokes.py"
      ],
      "docs": [
        "docs/VALIDATION.md",
        "docs/CI_TRIAGE.md"
      ],
      "checks": [
        "tools/validate_ci_policy.py",
        "tools/test_validate_ci_policy.py",
        "tools/test_run_smokes.py",
        "tools/validate_repo.py"
      ]
    },
    {
      "id": "public-camera-fallback",
      "boundary": "Rust-owned DC/NYC/Boston/SF publisher catalog and shared browser player. No discovery, private camera credentials, native RTSP decoder or recording.",
      "hardware_gate": "field_pending",
      "code": [
        "crates/pipboy-core/src/public_cameras.rs",
        "crates/pipboy/assets/cameras.js",
        "crates/pipboy/assets/cameras.css"
      ],
      "docs": [
        "docs/SECURITY_CAMERA_WALL.md"
      ],
      "checks": [
        "tools/test_cameras_ui.cjs"
      ],
      "acceptance": "Software catalog/lifecycle tests only; publisher playback and Mac/Pi operator acceptance remain provider/hardware dependent."
    },
    {
      "id": "offline-sync-v2",
      "boundary": "Offline-only synthetic delta planning and cooperative locked ledger; no live transport, authorization, or authenticated receipts.",
      "hardware_gate": "software_only",
      "code": [
        "crates/pipboy-core/src/sync_delta.rs",
        "crates/pipboy-core/src/sync_ledger.rs"
      ],
      "docs": [
        "docs/RB_SYNC_INTEGRATION.md",
        "docs/RB_SYNC_DELTA_PLANNER.md"
      ],
      "checks": [
        "tools/validate_component_index.py"
      ],
      "acceptance": "Unit cases added; exact-head build/CI not yet confirmed. No field deployment or secure fleet sync."
    },
    {
      "id": "universal-package-adapter",
      "boundary": "Portable typed adapter SDK, host-owned lifecycle, and one compile-time read-only rust_radio catalogue; no manifest-driven execution, playback, external sandbox or capability grants.",
      "code": [
        "crates/rust-boy-adapter-sdk/Cargo.toml",
        "crates/rust-boy-adapter-sdk/src/lib.rs",
        "crates/pipboy-core/src/universal_adapter.rs",
        "catalog/host_adapter_contract.json",
        "crates/pipboy-core/src/builtin_packages.rs",
        "catalog/builtin_packages/rust_radio.json"
      ],
      "docs": [
        "docs/UNIVERSAL_ADAPTER.md",
        "docs/PACKAGE_SOCKET.md",
        "docs/HOST_PACKAGE_ROADMAP.md",
        "docs/PROD_STATUS.md"
      ],
      "checks": [
        "tools/validate_host_packages.py",
        "tools/test_validate_host_packages.py"
      ],
      "hardware_gate": "software_only"
    },
    {
      "id": "codex-development-index",
      "boundary": "Branch-scoped Codex pass navigation, dependency and evidence records with offline deterministic validation. No executable manifest, hardware grant, scheduler or release authority.",
      "hardware_gate": "software_only",
      "code": [
        "AGENTS.md",
        "catalog/codex_passes.json",
        "tools/validate_codex_passes.py",
        "tools/test_validate_codex_passes.py",
        "tools/codex_next.py",
        "tools/test_codex_next.py"
      ],
      "docs": [
        "docs/CODEX_PASSES.md",
        "docs/INDEXING.md"
      ],
      "checks": [
        "tools/validate_codex_passes.py",
        "tools/test_validate_codex_passes.py",
        "tools/test_codex_next.py"
      ],
      "acceptance": "Current-head source, CI and documentation gate execution is still pending; pass structure is not production acceptance."
    }
  ]
}
