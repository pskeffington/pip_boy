#!/usr/bin/env python3
"""Open the on-demand Rust-Boy dashboard in the Linux desktop session.

The service and URL are fixed; neither browser input nor external package
metadata may select an executable, service, destination, or network address.
"""

import json
import os
import subprocess
import sys
import time
from urllib.error import HTTPError, URLError
from urllib.request import ProxyHandler, Request, build_opener

PORT = 8765
HEALTH_URL = f"http://127.0.0.1:{PORT}/api/healthz"
DASHBOARD_URL = f"http://127.0.0.1:{PORT}/"
SERVICE = "rust-boy-dashboard.service"


def is_ready():
    """Require the exact locally served Rust-Boy identity, not any 200 reply."""
    request = Request(HEALTH_URL, method="GET")
    opener = build_opener(ProxyHandler({}))  # Never send loopback to a proxy.
    try:
        with opener.open(request, timeout=0.5) as response:
            if response.status != 200:
                return False
            body = response.read(513)
        if len(body) > 512:
            return False
        payload = json.loads(body)
    except (HTTPError, URLError, OSError, TimeoutError, ValueError):
        return False
    return payload == {
        "schema_version": 1,
        "service": "rust-boy",
        "network": "loopback_only",
    }


def wait_until_ready(attempts=30, interval=0.15):
    for index in range(attempts):
        if is_ready():
            return True
        if index + 1 < attempts:
            time.sleep(interval)
    return False


def main(args=None):
    args = sys.argv[1:] if args is None else args
    if args == ["--help"]:
        print("usage: rust-boy-launcher [--micro]")
        return 0
    if args not in ([], ["--micro"]):
        print("rust-boy-launcher: unsupported arguments", file=sys.stderr)
        return 2
    if not sys.platform.startswith("linux"):
        print("rust-boy-launcher: Linux only", file=sys.stderr)
        return 1
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        print("rust-boy-launcher: graphical session required", file=sys.stderr)
        return 1

    try:
        subprocess.run(
            ["/usr/bin/systemctl", "--user", "start", SERVICE],
            check=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE, timeout=10,
        )
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
        print(f"rust-boy-launcher: cannot start user service: {error}", file=sys.stderr)
        return 1

    if not wait_until_ready():
        print("rust-boy-launcher: local service did not pass readiness", file=sys.stderr)
        return 1

    url = DASHBOARD_URL + ("micro" if args else "")
    try:
        subprocess.Popen(
            ["/usr/bin/xdg-open", url],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True,
        )
    except OSError as error:
        print(f"rust-boy-launcher: cannot open desktop browser: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
